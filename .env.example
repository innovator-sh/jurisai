# Copy to .env and fill in real values. Never commit .env.

# App
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:8000

# Auth (self-hosted JWT, Sprint 2) -- required. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=

# Chat store (self-hosted MongoDB, docker-compose)
MONGO_URI=mongodb://mongo:27017/jurisai

# Vector store (self-hosted Qdrant, docker-compose)
QDRANT_URL=http://qdrant:6333

# LLM provider -- only the selected one's key needs to be set (config.py
# fails fast on the specific missing key, not every provider's).
# groq (MVP default) | mistral (MVP alternate) | anthropic | bedrock (funded phase, stub)
LLM_PROVIDER=groq
GROQ_API_KEY=
MISTRAL_API_KEY=
ANTHROPIC_API_KEY=

# Retrieval tuning (Sprint 3) -- optional, these are the defaults
RETRIEVAL_K=5
RETRIEVAL_SCORE_THRESHOLD=0.5

# --- Compliance (Sprint 6: DPDP Act 2023 + CERT-In Directions 2022) ---------
# ENVIRONMENT=production makes the app REFUSE TO START unless the four
# values below the marker are set, so placeholder values can't ship by accident.
ENVIRONMENT=development
# Named grievance officer, shown on /privacy (DPDP). Real person, real contact.
GRIEVANCE_OFFICER_NAME=
GRIEVANCE_OFFICER_EMAIL=
GRIEVANCE_OFFICER_ADDRESS=
# Security-event log (CERT-In: 180 days, on the India-hosted VM). The prod
# overlay sets this to /var/log/jurisai on a named volume; leave empty in dev.
SECURITY_LOG_DIR=
# Chat turns auto-expire after this many days (stated on /privacy).
CHAT_RETENTION_DAYS=365
# How long scripts/backup_mongo.sh keeps archives (stated on /privacy).
BACKUP_RETENTION_DAYS=14
# Production only: false only for plain-HTTP local docker-compose.
COOKIE_SECURE=true

# --- Production hosting (docker-compose.prod.yml / Caddy) ------------------
# Public hostname whose DNS points at the VM; Caddy gets its TLS cert for it.
DOMAIN=
