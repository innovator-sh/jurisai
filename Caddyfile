# TLS termination + reverse proxy. DOMAIN comes from .env (e.g. jurisai.example.in);
# Caddy obtains and renews the Let's Encrypt certificate automatically, which needs
# DOMAIN's DNS to point at this VM and ports 80/443 reachable. See docs/deploy.md.
{$DOMAIN} {
	encode zstd gzip
	reverse_proxy app:8000

	header {
		-Server
		Strict-Transport-Security "max-age=31536000"
	}
}
